function Ic({ n, size = 16, color = "currentColor" }: { n: string; size?: number; color?: string }) {
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth={1.75} strokeLinecap="round" strokeLinejoin="round">
      {(P[n] ?? []).map((d, i) => <path key={i} d={d} />)}
    </svg>
  );
}

// ─── SCHEDULE DATA ───────────────────────────────────────────────────────────────
// Day indices: 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
// Today = Wed = index 3 (in the current week, Aug 26 2026)

type ClassStatus = "normal" | "cancelled" | "rescheduled" | "next";

type ClassBlock = {
  id: string;
  course: string; code: string; instructor: string; room: string; section: string;
  day: number;         // 0–6
  startHour: number;   // render position (new time for rescheduled)
  durationH: number;   // in hours
  color: string;
  status: ClassStatus;
  rescheduledTo?: string; // display label, e.g. "4:00 PM"
  originalHour?: number;  // original slot for rescheduled classes
};

// ─── LAYOUT ALGORITHM ────────────────────────────────────────────────────────────
// Assigns collision-free column slots to classes within a single day.
// Returns each class augmented with `col` (0-based) and `totalCols`.
type LayedOut = ClassBlock & { col: number; totalCols: number };

function layoutDay(classes: ClassBlock[]): LayedOut[] {
  if (classes.length === 0) return [];

  function overlaps(a: ClassBlock, b: ClassBlock) {
    return a.startHour < b.startHour + b.durationH &&
           b.startHour < a.startHour + a.durationH;
  }

  // Step 1 — find connected components of mutually/transitively overlapping classes
  const visited = new Set<string>();
  const components: ClassBlock[][] = [];
  const sorted = [...classes].sort((a, b) => a.startHour - b.startHour);

  for (const cls of sorted) {
    if (visited.has(cls.id)) continue;
    const component: ClassBlock[] = [];
    const queue = [cls];
    while (queue.length > 0) {
      const curr = queue.shift()!;
      if (visited.has(curr.id)) continue;
      visited.add(curr.id);
      component.push(curr);
      for (const other of sorted) {
        if (!visited.has(other.id) && overlaps(curr, other)) queue.push(other);
      }
    }
    components.push(component);
  }

  const result: LayedOut[] = [];

  for (const component of components) {
    const compSorted = [...component].sort((a, b) => a.startHour - b.startHour);
    // Step 2 — greedy column assignment within component
    const colEnds: number[] = [];
    const assignments: Array<{ cls: ClassBlock; col: number }> = [];

    for (const cls of compSorted) {
      let assignedCol = -1;
      for (let i = 0; i < colEnds.length; i++) {
        if (colEnds[i] <= cls.startHour) {
          assignedCol = i;
          colEnds[i] = cls.startHour + cls.durationH;
          break;
        }
      }
      if (assignedCol === -1) {
        assignedCol = colEnds.length;
        colEnds.push(cls.startHour + cls.durationH);
      }
      assignments.push({ cls, col: assignedCol });
    }

    const totalCols = colEnds.length;
    for (const { cls, col } of assignments) {
      result.push({ ...cls, col, totalCols });
    }
  }

  return result;
}

