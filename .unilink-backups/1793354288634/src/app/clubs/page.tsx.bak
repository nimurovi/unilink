const MEMBER_INIT: Record<string, MemberStatus> = { c1: "member", c2: "member", c4: "pending" };

// ─── OVERLAY ────────────────────────────────────────────────────────────────────
function Overlay({ onClose, children }: { onClose: () => void; children: React.ReactNode }) {
  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 300 }} onClick={onClose}>
      <div style={{ position: "absolute", inset: 0, background: "rgba(0,0,0,0.45)", backdropFilter: "blur(5px)" }} />
      <div onClick={e => e.stopPropagation()} style={{ position: "absolute", top: "50%", left: "50%", transform: "translate(-50%,-50%)" }}>
        {children}
      </div>
    </div>
  );
}

// ─── JOIN MODAL ─────────────────────────────────────────────────────────────────
type JoinStep = "form" | "application" | "success" | "submitted";
function JoinModal({ club, onClose, onDone }: { club: Club; onClose: () => void; onDone: () => void }) {
  const { theme } = useTheme(); const c = tok(theme);
  const [step, setStep] = useState<JoinStep>(club.joinType === "application" ? "application" : "form");
  const [why, setWhy] = useState("");

  const box: React.CSSProperties = {
    background: c.surface, border: `1px solid ${c.border}`, borderRadius: 20,
    padding: "28px 32px", minWidth: 420, maxWidth: 460,
    boxShadow: "0 24px 80px rgba(0,0,0,0.25)",
  };

  if (step === "success") {
    return (
      <Overlay onClose={onClose}>
        <div style={box}>
          <div style={{ textAlign: "center" }}>
            <div style={{ fontSize: 40, marginBottom: 14 }}>{club.emoji}</div>
            <div style={{ width: 52, height: 52, borderRadius: "50%", background: "rgba(16,185,129,0.1)", border: "1px solid rgba(16,185,129,0.25)", display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 16px" }}>
              <Ic n="check" size={24} color="#10B981" />
            </div>
            <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 20, color: c.text, marginBottom: 6 }}>You're now a member!</div>
            <div style={{ fontSize: 13, color: c.textMuted, marginBottom: 22, lineHeight: 1.6 }}>You'll receive updates about club events and announcements from <strong>{club.name}</strong>.</div>
            <div style={{ display: "flex", gap: 10 }}>
              <button onClick={onClose} style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>View Club</button>
              <button style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: c.primary, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>Explore Events</button>
            </div>
          </div>
        </div>
      </Overlay>
    );
  }

  if (step === "submitted") {
    return (
      <Overlay onClose={onClose}>
        <div style={box}>
          <div style={{ textAlign: "center" }}>
            <div style={{ fontSize: 40, marginBottom: 14 }}>{club.emoji}</div>
            <div style={{ width: 52, height: 52, borderRadius: "50%", background: "rgba(37,99,235,0.1)", border: "1px solid rgba(37,99,235,0.25)", display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 16px" }}>
              <Ic n="check" size={24} color={c.primary} />
            </div>
            <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 20, color: c.text, marginBottom: 6 }}>Application Submitted</div>
            <div style={{ fontSize: 13, color: c.textMuted, marginBottom: 14, lineHeight: 1.6 }}>Your membership request has been sent to <strong>{club.name}</strong>.</div>
            <div style={{ padding: "10px 14px", background: c.surface2, border: `1px solid ${c.border}`, borderRadius: 10, marginBottom: 20, display: "inline-flex", gap: 8, alignItems: "center" }}>
              <div style={{ width: 8, height: 8, borderRadius: "50%", background: "#F59E0B" }} />
              <span style={{ fontSize: 12, fontWeight: 600, color: "#F59E0B" }}>Pending Review</span>
            </div>
            <div style={{ display: "flex", gap: 10 }}>
              <button onClick={onClose} style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: c.primary, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>View Club</button>
              <button onClick={onClose} style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>Back to Clubs</button>
            </div>
          </div>
        </div>
      </Overlay>
    );
  }

  if (step === "application") {
    return (
      <Overlay onClose={onClose}>
        <div style={{ ...box, minWidth: 460 }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
            <div>
              <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 18, color: c.text }}>Join {club.name}</div>
              <div style={{ fontSize: 12, color: c.textDim, marginTop: 3 }}>Membership Application</div>
            </div>
            <button onClick={onClose} style={{ background: "none", border: "none", cursor: "pointer" }}><Ic n="x" size={18} color={c.textDim} /></button>
          </div>
          <div style={{ display: "flex", flexDirection: "column", gap: 14, marginBottom: 18 }}>
            {[
              { label: "Full Name", placeholder: "Ovi", type: "text" },
              { label: "Department", placeholder: "CSE", type: "text" },
            ].map(f => (
              <div key={f.label}>
                <label style={{ display: "block", fontSize: 11, fontWeight: 700, color: c.textDim, marginBottom: 5, textTransform: "uppercase", letterSpacing: "0.06em" }}>{f.label}</label>
                <input type={f.type} placeholder={f.placeholder}
                  style={{ width: "100%", padding: "9px 12px", borderRadius: 9, background: c.surface2, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 13, outline: "none", boxSizing: "border-box" }} />
              </div>
            ))}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10 }}>
              {[{ label: "Batch", placeholder: "52" }, { label: "Section", placeholder: "B" }].map(f => (
                <div key={f.label}>
                  <label style={{ display: "block", fontSize: 11, fontWeight: 700, color: c.textDim, marginBottom: 5, textTransform: "uppercase", letterSpacing: "0.06em" }}>{f.label}</label>
                  <input type="text" placeholder={f.placeholder}
                    style={{ width: "100%", padding: "9px 12px", borderRadius: 9, background: c.surface2, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 13, outline: "none", boxSizing: "border-box" }} />
                </div>
              ))}
            </div>
            <div>
              <label style={{ display: "block", fontSize: 11, fontWeight: 700, color: c.textDim, marginBottom: 5, textTransform: "uppercase", letterSpacing: "0.06em" }}>Why do you want to join?</label>
              <textarea rows={3} value={why} onChange={e => setWhy(e.target.value)} placeholder="Tell us briefly about yourself and your interest in this club..."
                style={{ width: "100%", padding: "9px 12px", borderRadius: 9, background: c.surface2, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 13, outline: "none", resize: "vertical", boxSizing: "border-box" }} />
            </div>
          </div>
          <button onClick={() => { setStep("submitted"); onDone(); }} style={{ width: "100%", padding: "11px 0", borderRadius: 10, background: c.primary, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 14, fontWeight: 700, cursor: "pointer" }}>
            Submit Application
          </button>
        </div>
      </Overlay>
    );
  }

  // Simple open join confirm
  return (
    <Overlay onClose={onClose}>
      <div style={box}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
          <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 18, color: c.text }}>Join {club.name}?</div>
          <button onClick={onClose} style={{ background: "none", border: "none", cursor: "pointer" }}><Ic n="x" size={18} color={c.textDim} /></button>
        </div>
        <div style={{ background: c.surface2, border: `1px solid ${c.border}`, borderRadius: 12, padding: "16px 18px", marginBottom: 18 }}>
          <div style={{ display: "flex", gap: 12, alignItems: "center", marginBottom: 10 }}>
            <div style={{ width: 40, height: 40, borderRadius: 12, background: `${club.color}12`, border: `1px solid ${club.color}25`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 20, flexShrink: 0 }}>{club.emoji}</div>
            <div>
              <div style={{ fontSize: 14, fontWeight: 700, color: c.text }}>{club.name}</div>
              <div style={{ fontSize: 11, color: c.textDim }}>{club.memberCount} members · {club.category}</div>
            </div>
          </div>
          <div style={{ fontSize: 12, color: c.textMuted, lineHeight: 1.6 }}>You'll become a member and receive club announcements and event updates.</div>
        </div>
        <div style={{ display: "flex", flexDirection: "column", gap: 10, marginBottom: 18 }}>
          {[{ label: "Name", val: "Ovi" }, { label: "Academic Program", val: "CSE" }, { label: "Batch", val: "52" }, { label: "Section", val: "B" }].map(r => (
            <div key={r.label} style={{ display: "flex", justifyContent: "space-between" }}>
              <span style={{ fontSize: 12, color: c.textDim }}>{r.label}</span>
              <span style={{ fontSize: 12, fontWeight: 600, color: c.text }}>{r.val}</span>
            </div>
          ))}
        </div>
        <div style={{ display: "flex", gap: 10 }}>
          <button onClick={onClose} style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>Cancel</button>
          <button onClick={() => { setStep("success"); onDone(); }} style={{ flex: 2, padding: "10px 0", borderRadius: 10, background: c.primary, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>Confirm Join</button>
        </div>
      </div>
    </Overlay>
  );
}

// ─── LEAVE MODAL ────────────────────────────────────────────────────────────────
function LeaveModal({ club, onClose, onLeave }: { club: Club; onClose: () => void; onLeave: () => void }) {
  const { theme } = useTheme(); const c = tok(theme);
  return (
    <Overlay onClose={onClose}>
      <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 20, padding: "28px 32px", minWidth: 380, boxShadow: "0 24px 80px rgba(0,0,0,0.25)" }}>
        <div style={{ width: 48, height: 48, borderRadius: "50%", background: "rgba(239,68,68,0.08)", border: "1px solid rgba(239,68,68,0.2)", display: "flex", alignItems: "center", justifyContent: "center", margin: "0 auto 16px" }}>
          <Ic n="alert" size={20} color="#EF4444" />
        </div>
        <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 18, color: c.text, marginBottom: 8, textAlign: "center" }}>Leave {club.name}?</div>
        <div style={{ fontSize: 13, color: c.textMuted, textAlign: "center", lineHeight: 1.6, marginBottom: 24 }}>You may no longer receive club announcements and member-only updates.</div>
        <div style={{ display: "flex", gap: 10 }}>
          <button onClick={onClose} style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>Keep Membership</button>
          <button onClick={onLeave} style={{ flex: 1, padding: "10px 0", borderRadius: 10, background: "#EF4444", color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>Leave Club</button>
        </div>
      </div>
    </Overlay>
  );
}

// ─── TOAST ──────────────────────────────────────────────────────────────────────
function Toast({ msg, onDismiss }: { msg: string; onDismiss: () => void }) {
  useEffect(() => { const t = setTimeout(onDismiss, 3000); return () => clearTimeout(t); }, [onDismiss]);
  return (
    <div style={{ position: "fixed", bottom: 28, left: "50%", transform: "translateX(-50%)", zIndex: 9999, background: "#1E293B", color: "#F8FAFC", borderRadius: 12, padding: "11px 20px", display: "flex", gap: 10, alignItems: "center", boxShadow: "0 8px 24px rgba(0,0,0,0.3)", fontFamily: "Inter", fontSize: 13, fontWeight: 500, whiteSpace: "nowrap" }}>
      <Ic n="check" size={13} color="#10B981" /> {msg}
      <button onClick={onDismiss} style={{ background: "none", border: "none", cursor: "pointer", padding: 0, marginLeft: 4 }}><Ic n="x" size={13} color="#94A3B8" /></button>
    </div>
  );
}

// ─── ATOMS ──────────────────────────────────────────────────────────────────────
function CatBadge({ cat }: { cat: string }) {
  const cfg = CAT_CFG[cat] ?? { color: "#64748B", bg: "rgba(100,116,139,0.08)" };
  return <span style={{ padding: "2px 8px", borderRadius: 6, fontSize: 10, fontWeight: 700, color: cfg.color, background: cfg.bg }}>{cat}</span>;
}

function MemberBadge({ status }: { status: MemberStatus }) {
  const cfg: Record<MemberStatus, { label: string; color: string; bg: string; border: string }> = {
    member:   { label: "✓ Member",          color: "#10B981", bg: "rgba(16,185,129,0.08)",  border: "rgba(16,185,129,0.2)"  },
    pending:  { label: "⟳ Pending",         color: "#F59E0B", bg: "rgba(245,158,11,0.08)",  border: "rgba(245,158,11,0.2)"  },
    rejected: { label: "✗ Not Approved",    color: "#94A3B8", bg: "rgba(148,163,184,0.08)", border: "rgba(148,163,184,0.2)" },
    left:     { label: "Left",              color: "#94A3B8", bg: "rgba(148,163,184,0.08)", border: "rgba(148,163,184,0.2)" },
    none:     { label: "",                  color: "",        bg: "",                        border: ""                      },
  };
  const s = cfg[status];
  if (!s.label) return null;
  return <span style={{ padding: "2px 9px", borderRadius: 999, fontSize: 10, fontWeight: 700, color: s.color, background: s.bg, border: `1px solid ${s.border}` }}>{s.label}</span>;
}

function StatCard({ label, value, icon, color, bg }: { label: string; value: string | number; icon: string; color: string; bg: string }) {
  const { theme } = useTheme(); const c = tok(theme);
  return (
    <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 16, padding: "16px 18px", boxShadow: c.cardShadow, display: "flex", alignItems: "center", gap: 14 }}>
      <div style={{ width: 42, height: 42, borderRadius: 12, background: bg, display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
        <Ic n={icon} size={19} color={color} />
      </div>
      <div>
        <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 24, color, lineHeight: 1 }}>{value}</div>
        <div style={{ fontSize: 12, fontWeight: 600, color: c.text, marginTop: 3 }}>{label}</div>
      </div>
    </div>
  );
}

// ─── CLUB CARD ──────────────────────────────────────────────────────────────────
function ClubCard({ club, status, saved, onJoin, onSave, onOpen }: {
  club: Club; status: MemberStatus; saved: boolean; onJoin: () => void; onSave: () => void; onOpen: () => void;
}) {
  const { theme } = useTheme(); const c = tok(theme);
  const [hov, setHov] = useState(false);

  return (
    <div onMouseEnter={() => setHov(true)} onMouseLeave={() => setHov(false)}
      style={{ background: c.surface, border: `1px solid ${hov ? club.color + "45" : c.border}`, borderRadius: 16, padding: "18px 20px", boxShadow: hov ? `0 6px 24px ${club.color}12, ${c.cardShadow}` : c.cardShadow, transition: "all 0.15s", display: "flex", flexDirection: "column" }}>
      <div style={{ height: 3, borderRadius: 2, background: club.color, marginBottom: 14, width: 36 }} />

      {/* Club avatar + info */}
      <div style={{ display: "flex", gap: 12, alignItems: "flex-start", marginBottom: 10 }}>
        <div style={{ width: 44, height: 44, borderRadius: 13, background: `${club.color}10`, border: `1px solid ${club.color}20`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 22, flexShrink: 0 }}>{club.emoji}</div>
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={{ display: "flex", gap: 6, alignItems: "center", flexWrap: "wrap", marginBottom: 3 }}>
            <CatBadge cat={club.category} />
            {club.joinType === "invite" && <Ic n="lock" size={10} color={c.textDim} />}
          </div>
          <div onClick={onOpen} style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 14, color: c.text, cursor: "pointer", lineHeight: 1.3, marginBottom: 1 }}>{club.name}</div>
          <div style={{ fontSize: 11, color: c.textDim }}>{club.department} · {club.memberCount} members</div>
        </div>
        <button onClick={e => { e.stopPropagation(); onSave(); }} style={{ padding: "5px", borderRadius: 7, background: saved ? "rgba(37,99,235,0.08)" : "transparent", border: `1px solid ${saved ? "rgba(37,99,235,0.2)" : "transparent"}`, cursor: "pointer", flexShrink: 0 }}>
          <Ic n="bookmark" size={13} color={saved ? "#2563EB" : c.textDim} />
        </button>
      </div>

      <div style={{ fontSize: 12, color: c.textMuted, lineHeight: 1.6, marginBottom: 12, flex: 1 }}>{club.description.slice(0, 90)}…</div>

      {status !== "none" && <div style={{ marginBottom: 10 }}><MemberBadge status={status} /></div>}

      <div style={{ display: "flex", gap: 8, marginTop: "auto" }}>
        <button onClick={onOpen} style={{ flex: 1, padding: "7px 0", borderRadius: 9, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 12, fontWeight: 600, cursor: "pointer" }}>View Club</button>
        {status === "none" && (
          <button onClick={onJoin} style={{ flex: 2, padding: "7px 0", borderRadius: 9, background: club.color, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 12, fontWeight: 700, cursor: "pointer" }}>
            {club.joinType === "application" ? "Apply to Join" : "Join Club"}
          </button>
        )}
        {status === "member" && (
          <button onClick={onOpen} style={{ flex: 2, padding: "7px 0", borderRadius: 9, background: "rgba(16,185,129,0.08)", border: "1px solid rgba(16,185,129,0.2)", color: "#10B981", fontFamily: "Inter", fontSize: 12, fontWeight: 700, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 5 }}>
            <Ic n="check" size={11} color="#10B981" /> Joined
          </button>
        )}
        {status === "pending" && (
          <div style={{ flex: 2, padding: "7px 0", borderRadius: 9, background: "rgba(245,158,11,0.08)", border: "1px solid rgba(245,158,11,0.2)", color: "#F59E0B", fontFamily: "Inter", fontSize: 12, fontWeight: 700, display: "flex", alignItems: "center", justifyContent: "center", gap: 5 }}>
            Pending
          </div>
        )}
      </div>
    </div>
  );
}

// ─── FEATURED BANNER ────────────────────────────────────────────────────────────
function FeaturedBanner({ club, status, saved, onJoin, onSave, onOpen }: { club: Club; status: MemberStatus; saved: boolean; onJoin: () => void; onSave: () => void; onOpen: () => void }) {
  const { theme } = useTheme(); const c = tok(theme);
  return (
    <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 20, padding: "24px 28px", boxShadow: c.cardShadow, display: "flex", justifyContent: "space-between", alignItems: "center", gap: 24, flexWrap: "wrap", marginBottom: 24, position: "relative", overflow: "hidden" }}>
      <div style={{ position: "absolute", top: 0, left: 0, right: 0, height: 3, background: club.color }} />
      <div style={{ display: "flex", gap: 18, alignItems: "center" }}>
        <div style={{ width: 56, height: 56, borderRadius: 16, background: `${club.color}12`, border: `1px solid ${club.color}25`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 28, flexShrink: 0 }}>{club.emoji}</div>
        <div>
          <div style={{ display: "flex", gap: 7, alignItems: "center", marginBottom: 5, flexWrap: "wrap" }}>
            <span style={{ fontSize: 10, fontWeight: 800, color: club.color, textTransform: "uppercase", letterSpacing: "0.1em" }}>Featured</span>
            <CatBadge cat={club.category} />
          </div>
          <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 18, color: c.text, marginBottom: 2 }}>{club.name}</div>
          <div style={{ fontSize: 13, color: c.textMuted, fontStyle: "italic" }}>"{club.tagline}"</div>
        </div>
      </div>
      <div style={{ display: "flex", gap: 18, alignItems: "center", flexWrap: "wrap", flexShrink: 0 }}>
        <div>
          <div style={{ fontSize: 10, fontWeight: 700, color: c.textDim, textTransform: "uppercase", letterSpacing: "0.06em", marginBottom: 2 }}>Members</div>
          <div style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 20, color: club.color }}>{club.memberCount}</div>
        </div>
        <div>
          <div style={{ fontSize: 10, fontWeight: 700, color: c.textDim, textTransform: "uppercase", letterSpacing: "0.06em", marginBottom: 2 }}>Department</div>
          <div style={{ fontSize: 13, fontWeight: 700, color: c.text }}>{club.department}</div>
        </div>
        <div style={{ display: "flex", gap: 8 }}>
          <button onClick={onOpen} style={{ padding: "9px 20px", borderRadius: 10, background: club.color, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer", whiteSpace: "nowrap" }}>View Club</button>
          {status === "none" && <button onClick={onJoin} style={{ padding: "9px 16px", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>Join</button>}
          {status === "member" && <div style={{ padding: "9px 14px", borderRadius: 10, background: "rgba(16,185,129,0.08)", border: "1px solid rgba(16,185,129,0.2)", color: "#10B981", fontFamily: "Inter", fontSize: 13, fontWeight: 700, display: "flex", alignItems: "center", gap: 5 }}><Ic n="check" size={13} color="#10B981" /> Joined</div>}
          <button onClick={onSave} style={{ padding: "9px 12px", borderRadius: 10, background: saved ? "rgba(37,99,235,0.08)" : c.surface2, border: `1px solid ${saved ? "rgba(37,99,235,0.2)" : c.border}`, cursor: "pointer" }}>
            <Ic n="bookmark" size={16} color={saved ? "#2563EB" : c.textDim} />
          </button>
        </div>
      </div>
    </div>
  );
}

// ─── CLUB DETAIL ────────────────────────────────────────────────────────────────
type ClubTab = "overview" | "events" | "announcements" | "recruitment" | "members";

function ClubDetail({ club, status, saved, onJoin, onLeave, onSave, onBack }: {
  club: Club; status: MemberStatus; saved: boolean;
  onJoin: () => void; onLeave: () => void; onSave: () => void; onBack: () => void;
}) {
  const { theme } = useTheme(); const c = tok(theme);
  const [tab, setTab] = useState<ClubTab>("overview");
  const [showLeave, setShowLeave] = useState(false);

  const TABS: { id: ClubTab; label: string }[] = [
    { id: "overview",       label: "Overview"      },
    { id: "events",         label: "Events"        },
    { id: "announcements",  label: "Announcements" },
    { id: "recruitment",    label: "Recruitment"   },
    { id: "members",        label: "Members"       },
  ];

  const LEADERSHIP = [
    { role: "President",        name: "Farhan Ahmed",   initials: "FA" },
    { role: "Vice President",   name: "Nusrat Islam",   initials: "NI" },
    { role: "General Secretary",name: "Sakib Hassan",   initials: "SH" },
    { role: "Faculty Advisor",  name: "Dr. M. Rahman",  initials: "DR" },
  ];

  const ANNOUNCEMENTS = [
    { title: "Weekly programming contest registration is open.", time: "2 hours ago", unread: true },
    { title: "New member orientation this Thursday at 4 PM.", time: "Yesterday", unread: false },
    { title: "Repository of last semester's problems now shared.", time: "3 days ago", unread: false },
  ];

  const EVENTS_LIST = [
    { title: "Programming Contest", date: "Sep 12", time: "9:00 AM", location: "Computer Lab 2" },
    { title: "AI Workshop", date: "Sep 18", time: "3:00 PM", location: "Seminar Hall" },
    { title: "Tech Career Seminar", date: "Oct 2", time: "2:00 PM", location: "Auditorium A" },
  ];

  const MEMBERS_SAMPLE = ["Ovi", "Rahim", "Nabila", "Sakib", "Tanvir", "Riya"];

  return (
    <div style={{ flex: 1, overflowY: "auto", padding: "28px 28px 100px", background: c.bg }}>
      <div style={{ maxWidth: 1000, margin: "0 auto" }}>
        <button onClick={onBack} style={{ display: "flex", alignItems: "center", gap: 6, background: "none", border: "none", color: c.textMuted, cursor: "pointer", fontFamily: "Inter", fontSize: 12, fontWeight: 600, marginBottom: 20, padding: 0 }}>
          <Ic n="arrowL" size={14} color={c.textMuted} /> Back to Clubs
        </button>

        {/* Header card */}
        <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 20, padding: "24px 28px", boxShadow: c.cardShadow, marginBottom: 20, position: "relative", overflow: "hidden" }}>
          <div style={{ position: "absolute", top: 0, left: 0, right: 0, height: 3, background: club.color }} />
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 16, flexWrap: "wrap" }}>
            <div style={{ display: "flex", gap: 18, alignItems: "center" }}>
              <div style={{ width: 64, height: 64, borderRadius: 18, background: `${club.color}10`, border: `1px solid ${club.color}25`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 32, flexShrink: 0 }}>{club.emoji}</div>
              <div>
                <div style={{ display: "flex", gap: 7, marginBottom: 6, flexWrap: "wrap", alignItems: "center" }}>
                  <CatBadge cat={club.category} />
                  {club.joinType === "application" && <span style={{ fontSize: 10, fontWeight: 700, color: "#F59E0B", background: "rgba(245,158,11,0.08)", border: "1px solid rgba(245,158,11,0.2)", borderRadius: 999, padding: "1px 7px" }}>Application Required</span>}
                  {club.joinType === "invite" && <span style={{ fontSize: 10, fontWeight: 700, color: "#94A3B8", background: "rgba(148,163,184,0.08)", border: "1px solid rgba(148,163,184,0.2)", borderRadius: 999, padding: "1px 7px" }}>Invite Only</span>}
                </div>
                <h1 style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 22, color: c.text, letterSpacing: "-0.01em", marginBottom: 3 }}>{club.name}</h1>
                <div style={{ fontSize: 13, color: c.textMuted, fontStyle: "italic" }}>"{club.tagline}"</div>
              </div>
            </div>
            <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
              {status === "none" && (
                <button onClick={onJoin} style={{ padding: "9px 22px", borderRadius: 10, background: club.color, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>
                  {club.joinType === "application" ? "Apply to Join" : "Join Club"}
                </button>
              )}
              {status === "member" && (
                <button onClick={() => setShowLeave(true)} style={{ padding: "9px 16px", borderRadius: 10, background: "rgba(16,185,129,0.08)", border: "1px solid rgba(16,185,129,0.2)", color: "#10B981", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer", display: "flex", alignItems: "center", gap: 6 }}>
                  <Ic n="check" size={13} color="#10B981" /> Joined · Leave
                </button>
              )}
              {status === "pending" && (
                <div style={{ padding: "9px 16px", borderRadius: 10, background: "rgba(245,158,11,0.08)", border: "1px solid rgba(245,158,11,0.2)", color: "#F59E0B", fontFamily: "Inter", fontSize: 13, fontWeight: 600 }}>⟳ Pending Review</div>
              )}
              <button onClick={onSave} style={{ padding: "9px 14px", borderRadius: 10, background: saved ? "rgba(37,99,235,0.08)" : c.surface2, border: `1px solid ${saved ? "rgba(37,99,235,0.25)" : c.border}`, color: saved ? "#2563EB" : c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer", display: "flex", alignItems: "center", gap: 6 }}>
                <Ic n="bookmark" size={14} color={saved ? "#2563EB" : c.textMuted} /> {saved ? "Saved" : "Save Club"}
              </button>
            </div>
          </div>

          {/* Meta strip */}
          <div style={{ display: "flex", gap: 24, marginTop: 20, paddingTop: 18, borderTop: `1px solid ${c.border}`, flexWrap: "wrap" }}>
            {[
              { label: "Members",   val: club.memberCount.toString() },
              { label: "Founded",   val: club.founded.toString() },
              { label: "Department",val: club.department },
              { label: "Category",  val: club.category },
              { label: "Meeting",   val: `${club.meetingDay} · ${club.meetingTime}` },
              { label: "Location",  val: club.meetingLocation },
            ].map(m => (
              <div key={m.label}>
                <div style={{ fontSize: 10, fontWeight: 700, color: c.textDim, textTransform: "uppercase", letterSpacing: "0.06em", marginBottom: 3 }}>{m.label}</div>
                <div style={{ fontSize: 13, fontWeight: 600, color: c.text }}>{m.val}</div>
              </div>
            ))}
          </div>
        </div>

        {/* Tabs */}
        <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 16, overflow: "hidden", boxShadow: c.cardShadow, marginBottom: 18 }}>
          <div style={{ display: "flex", borderBottom: `1px solid ${c.border}`, overflowX: "auto" }}>
            {TABS.map(t => (
              <button key={t.id} onClick={() => setTab(t.id)}
                style={{ padding: "14px 20px", fontFamily: "Inter", fontSize: 13, fontWeight: tab === t.id ? 700 : 500, color: tab === t.id ? club.color : c.textMuted, background: "none", border: "none", cursor: "pointer", borderBottom: `2px solid ${tab === t.id ? club.color : "transparent"}`, marginBottom: -1, whiteSpace: "nowrap", transition: "all 0.15s" }}>
                {t.label}
                {t.id === "announcements" && <span style={{ marginLeft: 6, padding: "1px 6px", borderRadius: 999, fontSize: 10, fontWeight: 700, background: club.color, color: "#fff" }}>3</span>}
              </button>
            ))}
          </div>

          <div style={{ padding: "22px 24px" }}>
            {tab === "overview" && (
              <div style={{ display: "grid", gridTemplateColumns: "1fr 300px", gap: 20 }}>
                <div>
                  <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text, marginBottom: 12 }}>About the Club</div>
                  <p style={{ fontSize: 14, color: c.textMuted, lineHeight: 1.75, marginBottom: 22 }}>{club.description}</p>

                  <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text, marginBottom: 12 }}>Club Leadership</div>
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 22 }}>
                    {LEADERSHIP.map(l => (
                      <div key={l.role} style={{ display: "flex", gap: 10, alignItems: "center", padding: "11px 13px", background: c.surface2, borderRadius: 11, border: `1px solid ${c.border}` }}>
                        <div style={{ width: 34, height: 34, borderRadius: 10, background: `${club.color}12`, border: `1px solid ${club.color}20`, display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "Manrope", fontWeight: 700, fontSize: 12, color: club.color, flexShrink: 0 }}>{l.initials}</div>
                        <div>
                          <div style={{ fontSize: 12, fontWeight: 700, color: c.text }}>{l.name}</div>
                          <div style={{ fontSize: 10, color: c.textDim }}>{l.role}</div>
                        </div>
                      </div>
                    ))}
                  </div>

                  {(club.website || club.social) && (
                    <>
                      <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text, marginBottom: 12 }}>Connect With Us</div>
                      <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
                        {club.website && [
                          { label: "Website", icon: "globe", color: "#2563EB" },
                          { label: "Email",   icon: "mail",  color: "#F59E0B" },
                        ].map(l => (
                          <button key={l.label} style={{ display: "flex", gap: 6, alignItems: "center", padding: "7px 14px", borderRadius: 9, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 12, fontWeight: 600, cursor: "pointer" }}>
                            <Ic n={l.icon} size={13} color={l.color} /> {l.label}
                          </button>
                        ))}
                        {club.social && [
                          { label: "Facebook",  emoji: "📘" },
                          { label: "Instagram", emoji: "📸" },
                        ].map(l => (
                          <button key={l.label} style={{ display: "flex", gap: 6, alignItems: "center", padding: "7px 14px", borderRadius: 9, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 12, fontWeight: 600, cursor: "pointer" }}>
                            <span style={{ fontSize: 14 }}>{l.emoji}</span> {l.label}
                          </button>
                        ))}
                      </div>
                    </>
                  )}
                </div>

                {/* Sidebar */}
                <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
                  <div style={{ background: c.surface2, border: `1px solid ${c.border}`, borderRadius: 14, padding: "16px 18px" }}>
                    <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 13, color: c.text, marginBottom: 12 }}>Quick Info</div>
                    {[
                      { icon: "users",    label: `${club.memberCount} members` },
                      { icon: "calendar", label: `${club.meetingDay}s at ${club.meetingTime}` },
                      { icon: "map",      label: club.meetingLocation },
                      { icon: "clock",    label: `Founded ${club.founded}` },
                    ].map(r => (
                      <div key={r.label} style={{ display: "flex", gap: 8, alignItems: "center", marginBottom: 8 }}>
                        <Ic n={r.icon} size={13} color={c.textDim} />
                        <span style={{ fontSize: 12, color: c.textMuted }}>{r.label}</span>
                      </div>
                    ))}
                  </div>

                  <div style={{ background: c.surface2, border: `1px solid ${c.border}`, borderRadius: 14, padding: "16px 18px" }}>
                    <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 13, color: c.text, marginBottom: 12 }}>Club Members</div>
                    <div style={{ display: "flex", gap: -4, marginBottom: 10 }}>
                      {MEMBERS_SAMPLE.slice(0, 5).map((m, i) => (
                        <div key={m} style={{ width: 32, height: 32, borderRadius: "50%", background: `hsl(${i * 47},60%,55%)`, border: `2px solid ${c.surface}`, display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "Manrope", fontWeight: 700, fontSize: 11, color: "#fff", marginLeft: i === 0 ? 0 : -8 }}>{m[0]}</div>
                      ))}
                      <div style={{ width: 32, height: 32, borderRadius: "50%", background: c.surface3, border: `2px solid ${c.surface}`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 10, fontWeight: 700, color: c.textMuted, marginLeft: -8 }}>+{club.memberCount - 5}</div>
                    </div>
                    <button style={{ width: "100%", padding: "7px 0", borderRadius: 9, background: c.surface3, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 12, fontWeight: 600, cursor: "pointer" }}>View Members</button>
                  </div>
                </div>
              </div>
            )}

            {tab === "events" && (
              <div>
                <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text, marginBottom: 16 }}>Upcoming Club Events</div>
                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {EVENTS_LIST.map((ev, i) => (
                    <div key={i} style={{ display: "flex", gap: 12, alignItems: "center", padding: "13px 16px", background: c.surface2, borderRadius: 12, border: `1px solid ${c.border}`, cursor: "pointer" }}
                      onMouseEnter={e => ((e.currentTarget as HTMLElement).style.background = c.surface3)}
                      onMouseLeave={e => ((e.currentTarget as HTMLElement).style.background = c.surface2)}>
                      <div style={{ width: 4, height: 40, borderRadius: 2, background: club.color, flexShrink: 0 }} />
                      <div style={{ flex: 1 }}>
                        <div style={{ fontSize: 13, fontWeight: 700, color: c.text, marginBottom: 3 }}>{ev.title}</div>
                        <div style={{ fontSize: 11, color: c.textDim }}>{ev.date} · {ev.time} · {ev.location}</div>
                      </div>
                      <button style={{ padding: "6px 14px", borderRadius: 8, background: club.color, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 11, fontWeight: 700, cursor: "pointer" }}>View Event</button>
                    </div>
                  ))}
                </div>
                <button style={{ marginTop: 14, width: "100%", padding: "9px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>View All Events</button>
              </div>
            )}

            {tab === "announcements" && (
              <div>
                <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text, marginBottom: 16 }}>Club Announcements</div>
                <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                  {ANNOUNCEMENTS.map((ann, i) => (
                    <div key={i} style={{ padding: "14px 16px", background: ann.unread ? `${club.color}05` : c.surface2, borderRadius: 12, border: `1px solid ${ann.unread ? club.color + "25" : c.border}`, cursor: "pointer" }}
                      onMouseEnter={e => ((e.currentTarget as HTMLElement).style.background = c.surface3)}
                      onMouseLeave={e => ((e.currentTarget as HTMLElement).style.background = ann.unread ? `${club.color}05` : c.surface2)}>
                      <div style={{ display: "flex", gap: 10, alignItems: "flex-start" }}>
                        {ann.unread && <div style={{ width: 7, height: 7, borderRadius: "50%", background: club.color, marginTop: 5, flexShrink: 0 }} />}
                        <div style={{ flex: 1 }}>
                          <div style={{ fontSize: 13, fontWeight: ann.unread ? 600 : 500, color: c.text, lineHeight: 1.5, marginBottom: 4 }}>{ann.title}</div>
                          <div style={{ fontSize: 11, color: c.textDim }}>{club.name} · {ann.time}</div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                <button style={{ marginTop: 14, width: "100%", padding: "9px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>View All Announcements</button>
              </div>
            )}

            {tab === "recruitment" && (
              <div style={{ maxWidth: 560 }}>
                <div style={{ display: "flex", gap: 8, alignItems: "center", marginBottom: 16 }}>
                  <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text }}>Recruitment</div>
                  {club.recruitmentOpen
                    ? <span style={{ padding: "2px 9px", borderRadius: 999, fontSize: 10, fontWeight: 700, color: "#10B981", background: "rgba(16,185,129,0.08)", border: "1px solid rgba(16,185,129,0.2)" }}>Open</span>
                    : <span style={{ padding: "2px 9px", borderRadius: 999, fontSize: 10, fontWeight: 700, color: "#94A3B8", background: "rgba(148,163,184,0.08)", border: "1px solid rgba(148,163,184,0.2)" }}>Closed</span>}
                </div>
                {club.recruitmentOpen ? (
                  <>
                    <div style={{ fontSize: 13, color: c.textMuted, marginBottom: 18, lineHeight: 1.6 }}>Recruitment is currently open. Apply for any open position below.</div>
                    {club.recruitmentDeadline && (
                      <div style={{ padding: "10px 14px", background: "rgba(245,158,11,0.05)", border: "1px solid rgba(245,158,11,0.2)", borderRadius: 10, marginBottom: 18, display: "flex", gap: 8, alignItems: "center" }}>
                        <Ic n="clock" size={13} color="#F59E0B" />
                        <span style={{ fontSize: 12, color: "#F59E0B", fontWeight: 600 }}>Deadline: {club.recruitmentDeadline}</span>
                      </div>
                    )}
                    <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 20 }}>
                      {["Event Volunteer","Social Media Team","Technical Team","Design Team"].map(pos => (
                        <div key={pos} style={{ padding: "12px 14px", background: c.surface2, borderRadius: 11, border: `1px solid ${c.border}` }}>
                          <div style={{ fontSize: 13, fontWeight: 600, color: c.text, marginBottom: 4 }}>{pos}</div>
                          <div style={{ fontSize: 11, color: c.textDim }}>Open position</div>
                        </div>
                      ))}
                    </div>
                    <button style={{ width: "100%", padding: "10px 0", borderRadius: 10, background: club.color, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>Apply for Recruitment</button>
                  </>
                ) : (
                  <div style={{ padding: "40px 24px", textAlign: "center", background: c.surface2, borderRadius: 14, border: `1px solid ${c.border}` }}>
                    <div style={{ fontSize: 13, color: c.textDim }}>Recruitment is currently closed. Check back later.</div>
                  </div>
                )}
              </div>
            )}

            {tab === "members" && (
              <div>
                <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16 }}>
                  <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 14, color: c.text }}>Club Members</div>
                  <span style={{ fontSize: 12, color: c.textDim }}>{club.memberCount} total</span>
                </div>
                <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill,minmax(160px,1fr))", gap: 10, marginBottom: 14 }}>
                  {["Ovi","Farhan","Nusrat","Sakib","Rahim","Nabila","Tanvir","Riya","Imran","Sumaiya"].map((name, i) => (
                    <div key={name} style={{ display: "flex", gap: 9, alignItems: "center", padding: "10px 12px", background: c.surface2, borderRadius: 10, border: `1px solid ${c.border}` }}>
                      <div style={{ width: 30, height: 30, borderRadius: 9, background: `hsl(${i * 36},55%,55%)`, display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "Manrope", fontWeight: 700, fontSize: 12, color: "#fff", flexShrink: 0 }}>{name[0]}</div>
                      <div>
                        <div style={{ fontSize: 12, fontWeight: 600, color: c.text }}>{name}</div>
                        <div style={{ fontSize: 10, color: c.textDim }}>CSE · Batch 52</div>
                      </div>
                    </div>
                  ))}
                </div>
                <button style={{ width: "100%", padding: "9px 0", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>View All Members</button>
              </div>
            )}
          </div>
        </div>
      </div>

      {showLeave && <LeaveModal club={club} onClose={() => setShowLeave(false)} onLeave={() => { onLeave(); setShowLeave(false); }} />}
    </div>
  );
}

// ─── MY CLUBS ───────────────────────────────────────────────────────────────────
function MyClubs({ memberStatus, onOpenClub, onBrowse }: {
  memberStatus: Record<string, MemberStatus>; onOpenClub: (club: Club) => void; onBrowse: () => void;
}) {
  const { theme } = useTheme(); const c = tok(theme);
  const joined  = CLUBS.filter(cl => memberStatus[cl.id] === "member");
  const pending = CLUBS.filter(cl => memberStatus[cl.id] === "pending");

  const ACTIVITY = [
    { club: "CSE Programming Club", note: "New announcement", time: "2 hours ago", emoji: "📢" },
    { club: "Robotics Club",        note: "Workshop added",   time: "Yesterday",   emoji: "🤖" },
    { club: "Debate Society",       note: "Recruitment opened",time: "Aug 25",     emoji: "🎙️" },
  ];

  return (
    <div style={{ flex: 1, overflowY: "auto", padding: "28px 28px 100px", background: c.bg }}>
      <div style={{ maxWidth: 900, margin: "0 auto" }}>
        <div style={{ marginBottom: 24 }}>
          <h1 style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 24, color: c.text, letterSpacing: "-0.02em", marginBottom: 4 }}>My Clubs</h1>
          <p style={{ fontSize: 13, color: c.textMuted }}>Manage the communities you're part of.</p>
          <div style={{ display: "flex", gap: 16, marginTop: 10 }}>
            <span style={{ fontSize: 12, fontWeight: 700, color: c.text }}>Joined Clubs <span style={{ color: c.primary }}>{joined.length}</span></span>
            <span style={{ fontSize: 12, fontWeight: 700, color: c.text }}>Pending Requests <span style={{ color: "#F59E0B" }}>{pending.length}</span></span>
          </div>
        </div>

        {/* Joined */}
        <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 15, color: c.text, marginBottom: 14 }}>Joined Clubs</div>
        {joined.length === 0 ? (
          <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 18, padding: "50px 24px", textAlign: "center", boxShadow: c.cardShadow, marginBottom: 24 }}>
            <div style={{ fontSize: 32, marginBottom: 12 }}>🤝</div>
            <div style={{ fontSize: 15, fontWeight: 700, color: c.text, marginBottom: 6 }}>You haven't joined any clubs yet.</div>
            <button onClick={onBrowse} style={{ marginTop: 12, padding: "9px 22px", borderRadius: 10, background: c.primary, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 13, fontWeight: 700, cursor: "pointer" }}>Discover Clubs</button>
          </div>
        ) : (
          <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 18, overflow: "hidden", boxShadow: c.cardShadow, marginBottom: 24 }}>
            {joined.map((cl, i) => (
              <div key={cl.id} style={{ display: "flex", gap: 14, alignItems: "center", padding: "15px 20px", borderBottom: i < joined.length - 1 ? `1px solid ${c.border}` : "none", transition: "background 0.13s" }}
                onMouseEnter={e => ((e.currentTarget as HTMLElement).style.background = c.surface2)}
                onMouseLeave={e => ((e.currentTarget as HTMLElement).style.background = "transparent")}>
                <div style={{ width: 4, height: 44, borderRadius: 2, background: cl.color, flexShrink: 0 }} />
                <div style={{ width: 38, height: 38, borderRadius: 11, background: `${cl.color}10`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 18, flexShrink: 0 }}>{cl.emoji}</div>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div style={{ fontSize: 13, fontWeight: 700, color: c.text, marginBottom: 2 }}>{cl.name}</div>
                  <div style={{ fontSize: 11, color: c.textDim }}>
                    {cl.nextEvent ? `Next: ${cl.nextEvent.title} · ${cl.nextEvent.date}` : `${cl.memberCount} members`}
                  </div>
                </div>
                <MemberBadge status="member" />
                <button onClick={() => onOpenClub(cl)} style={{ padding: "7px 16px", borderRadius: 9, background: c.primary, color: "#fff", border: "none", fontFamily: "Inter", fontSize: 12, fontWeight: 700, cursor: "pointer" }}>View Club</button>
              </div>
            ))}
          </div>
        )}

        {/* Pending */}
        {pending.length > 0 && (
          <>
            <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 15, color: c.text, marginBottom: 14 }}>Pending Requests</div>
            <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 18, overflow: "hidden", boxShadow: c.cardShadow, marginBottom: 24 }}>
              {pending.map((cl, i) => (
                <div key={cl.id} style={{ display: "flex", gap: 14, alignItems: "center", padding: "15px 20px", borderBottom: i < pending.length - 1 ? `1px solid ${c.border}` : "none" }}>
                  <div style={{ width: 38, height: 38, borderRadius: 11, background: `${cl.color}10`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 18, flexShrink: 0 }}>{cl.emoji}</div>
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontSize: 13, fontWeight: 700, color: c.text, marginBottom: 2 }}>{cl.name}</div>
                    <div style={{ fontSize: 11, color: c.textDim }}>Request sent: Aug 28</div>
                  </div>
                  <span style={{ fontSize: 11, fontWeight: 700, color: "#F59E0B", background: "rgba(245,158,11,0.08)", border: "1px solid rgba(245,158,11,0.2)", borderRadius: 999, padding: "2px 10px" }}>Pending</span>
                  <button style={{ padding: "6px 12px", borderRadius: 8, background: c.surface2, border: `1px solid ${c.border}`, color: c.textDim, fontFamily: "Inter", fontSize: 11, fontWeight: 600, cursor: "pointer" }}>Cancel Request</button>
                </div>
              ))}
            </div>
          </>
        )}

        {/* Recent Activity */}
        <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 15, color: c.text, marginBottom: 14 }}>Recent Club Activity</div>
        <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 18, overflow: "hidden", boxShadow: c.cardShadow }}>
          {ACTIVITY.map((a, i) => (
            <div key={i} style={{ display: "flex", gap: 12, alignItems: "center", padding: "13px 20px", borderBottom: i < ACTIVITY.length - 1 ? `1px solid ${c.border}` : "none" }}>
              <div style={{ width: 34, height: 34, borderRadius: 10, background: c.surface2, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 16, flexShrink: 0 }}>{a.emoji}</div>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 12, fontWeight: 700, color: c.text, marginBottom: 2 }}>{a.club}</div>
                <div style={{ fontSize: 11, color: c.textDim }}>{a.note}</div>
              </div>
              <span style={{ fontSize: 11, color: c.textDim }}>{a.time}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// ─── CLUBS LIST ─────────────────────────────────────────────────────────────────
const CAT_FILTERS = ["All","Academic","Technology","Programming","Robotics","Research","Sports","Cultural","Debate","Photography","Volunteering","Career","Arts"] as const;

function ClubsList({ memberStatus, savedIds, onJoin, onToggleSave, onOpenClub, onMyClubs }: {
  memberStatus: Record<string, MemberStatus>; savedIds: Set<string>;
  onJoin: (club: Club) => void; onToggleSave: (id: string) => void;
  onOpenClub: (club: Club) => void; onMyClubs: () => void;
}) {
  const { theme } = useTheme(); const c = tok(theme);
  const [cat, setCat] = useState("All");
  const [query, setQuery] = useState("");
  const [sort, setSort] = useState("Popular");
  const [toast, setToast] = useState<string | null>(null);

  const featured = CLUBS.find(cl => cl.featured)!;
  const rest = CLUBS.filter(cl => !cl.featured);

  const filtered = rest.filter(cl => {
    const mq = !query || cl.name.toLowerCase().includes(query.toLowerCase()) || cl.category.toLowerCase().includes(query.toLowerCase()) || cl.department.toLowerCase().includes(query.toLowerCase());
    const mc = cat === "All" || cl.category === cat;
    return mq && mc;
  });

  const recommended = CLUBS.filter(cl => ["c6","c7","c2"].includes(cl.id));

  function handleSave(id: string) {
    const was = savedIds.has(id);
    onToggleSave(id);
    setToast(was ? "Removed from saved" : "Club saved");
  }

  const joinedCount = Object.values(memberStatus).filter(s => s === "member").length;

  return (
    <div style={{ flex: 1, overflowY: "auto", padding: "28px 28px 100px", background: c.bg }}>
      <div style={{ maxWidth: 1100, margin: "0 auto" }}>

        {/* Header */}
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", gap: 16, marginBottom: 24, flexWrap: "wrap" }}>
          <div>
            <h1 style={{ fontFamily: "Manrope", fontWeight: 800, fontSize: 24, color: c.text, letterSpacing: "-0.02em", marginBottom: 4 }}>Clubs & Communities</h1>
            <p style={{ fontSize: 13, color: c.textMuted }}>Discover communities, connect with students, and find clubs that match your interests.</p>
          </div>
          <button onClick={onMyClubs} style={{ display: "flex", alignItems: "center", gap: 6, padding: "9px 18px", borderRadius: 10, background: c.surface, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer", flexShrink: 0, whiteSpace: "nowrap" }}>
            <Ic n="users" size={14} color={c.textMuted} /> My Clubs {joinedCount > 0 && <span style={{ padding: "1px 7px", borderRadius: 999, fontSize: 11, fontWeight: 700, background: `${c.primary}10`, color: c.primary }}>{joinedCount}</span>}
          </button>
        </div>

        {/* Stats */}
        <div style={{ display: "grid", gridTemplateColumns: "repeat(4,1fr)", gap: 14, marginBottom: 24 }}>
          <StatCard label="Total Clubs"     value={CLUBS.length}  icon="users"    color="#2563EB" bg="rgba(37,99,235,0.08)"  />
          <StatCard label="Your Clubs"      value={joinedCount}   icon="check"    color="#10B981" bg="rgba(16,185,129,0.08)" />
          <StatCard label="Open to Join"    value="8"             icon="zap"      color="#F59E0B" bg="rgba(245,158,11,0.08)" />
          <StatCard label="Saved"           value={savedIds.size} icon="bookmark" color="#8B5CF6" bg="rgba(139,92,246,0.08)" />
        </div>

        {/* Featured */}
        <FeaturedBanner club={featured} status={memberStatus[featured.id] ?? "none"} saved={savedIds.has(featured.id)}
          onJoin={() => onJoin(featured)} onSave={() => handleSave(featured.id)} onOpen={() => onOpenClub(featured)} />

        {/* Search + filters */}
        <div style={{ display: "flex", gap: 10, marginBottom: 14, flexWrap: "wrap", alignItems: "center" }}>
          <div style={{ position: "relative", flex: "1 1 220px", minWidth: 180 }}>
            <div style={{ position: "absolute", left: 11, top: "50%", transform: "translateY(-50%)" }}><Ic n="search" size={14} color={c.textDim} /></div>
            <input value={query} onChange={e => setQuery(e.target.value)} placeholder="Search clubs and communities..."
              style={{ width: "100%", padding: "8px 12px 8px 34px", borderRadius: 9, background: c.surface, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 13, outline: "none", boxSizing: "border-box" }} />
          </div>
          <select style={{ padding: "8px 12px", borderRadius: 9, background: c.surface, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 12, cursor: "pointer", outline: "none" }}>
            <option>All Departments</option><option>CSE</option><option>EEE</option><option>BBA</option>
          </select>
          <select style={{ padding: "8px 12px", borderRadius: 9, background: c.surface, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 12, cursor: "pointer", outline: "none" }}>
            <option>Membership: All</option><option>Joined</option><option>Not Joined</option>
          </select>
          <select style={{ padding: "8px 12px", borderRadius: 9, background: c.surface, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 12, cursor: "pointer", outline: "none" }}>
            <option>Type: All</option><option>University</option><option>Department</option><option>Student Community</option>
          </select>
          <select value={sort} onChange={e => setSort(e.target.value)}
            style={{ padding: "8px 12px", borderRadius: 9, background: c.surface, border: `1px solid ${c.border}`, color: c.text, fontFamily: "Inter", fontSize: 12, cursor: "pointer", outline: "none" }}>
            <option>Popular</option><option>Newest</option><option>Most Active</option>
          </select>
        </div>

        {/* Category chips */}
        <div style={{ display: "flex", gap: 6, marginBottom: 20, flexWrap: "wrap" }}>
          {CAT_FILTERS.map(f => (
            <button key={f} onClick={() => setCat(f)}
              style={{ padding: "5px 14px", borderRadius: 999, fontSize: 12, fontWeight: cat === f ? 700 : 500, background: cat === f ? `${c.primary}10` : "transparent", color: cat === f ? c.primary : c.textMuted, border: `1px solid ${cat === f ? c.primary + "30" : c.border}`, cursor: "pointer", transition: "all 0.13s" }}>
              {f}
            </button>
          ))}
        </div>

        {/* Recommended */}
        {!query && cat === "All" && (
          <div style={{ marginBottom: 28 }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 6 }}>
              <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 15, color: c.text }}>Recommended For You</div>
            </div>
            <div style={{ fontSize: 12, color: c.textDim, marginBottom: 14, display: "flex", alignItems: "center", gap: 6 }}>
              <Ic n="zap" size={12} color={c.primary} /> Recommended based on your interests and courses.
            </div>
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill,minmax(280px,1fr))", gap: 14 }}>
              {recommended.map(cl => (
                <ClubCard key={cl.id} club={cl} status={memberStatus[cl.id] ?? "none"} saved={savedIds.has(cl.id)}
                  onJoin={() => onJoin(cl)} onSave={() => handleSave(cl.id)} onOpen={() => onOpenClub(cl)} />
              ))}
            </div>
          </div>
        )}

        {/* All clubs / filtered */}
        <div style={{ fontFamily: "Manrope", fontWeight: 700, fontSize: 15, color: c.text, marginBottom: 14 }}>
          {cat === "All" && !query ? "All Clubs" : "Results"}
          {filtered.length > 0 && <span style={{ fontSize: 12, fontWeight: 400, color: c.textDim, marginLeft: 8 }}>{filtered.length} club{filtered.length !== 1 ? "s" : ""}</span>}
        </div>
        {filtered.length === 0 ? (
          <div style={{ background: c.surface, border: `1px solid ${c.border}`, borderRadius: 18, padding: "60px 24px", textAlign: "center", boxShadow: c.cardShadow }}>
            <div style={{ fontSize: 32, marginBottom: 12 }}>🔍</div>
            <div style={{ fontSize: 15, fontWeight: 700, color: c.text, marginBottom: 6 }}>No Clubs Found</div>
            <div style={{ fontSize: 13, color: c.textDim, marginBottom: 20 }}>Try another search or category.</div>
            <button onClick={() => { setQuery(""); setCat("All"); }} style={{ padding: "9px 20px", borderRadius: 10, background: c.surface2, border: `1px solid ${c.border}`, color: c.textMuted, fontFamily: "Inter", fontSize: 13, fontWeight: 600, cursor: "pointer" }}>Clear Filters</button>
          </div>
        ) : (
          <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill,minmax(280px,1fr))", gap: 16 }}>
            {filtered.map(cl => (
              <ClubCard key={cl.id} club={cl} status={memberStatus[cl.id] ?? "none"} saved={savedIds.has(cl.id)}
                onJoin={() => onJoin(cl)} onSave={() => handleSave(cl.id)} onOpen={() => onOpenClub(cl)} />
            ))}
          </div>
        )}
      </div>
      {toast && <Toast msg={toast} onDismiss={() => setToast(null)} />}
    </div>
  );
}

// ─── ROOT ────────────────────────────────────────────────────────────────────────
type ClubView = "list" | "detail" | "myclubs";

export default function ClubsPage() {
  const [view, setView]              = useState<ClubView>("list");
  const [selected, setSelected]      = useState<Club | null>(null);
  const [memberStatus, setMemberStatus] = useState<Record<string, MemberStatus>>(MEMBER_INIT);
  const [savedIds, setSavedIds]      = useState<Set<string>>(new Set(["c1","c6"]));
  const [joinTarget, setJoinTarget]  = useState<Club | null>(null);
  const [toast, setToast]            = useState<string | null>(null);

  function toggleSave(id: string) {
    setSavedIds(prev => { const n = new Set(prev); n.has(id) ? n.delete(id) : n.add(id); return n; });
  }
  function openJoin(club: Club) { setJoinTarget(club); }
  function handleJoinDone() {
    if (!joinTarget) return;
    const next: MemberStatus = joinTarget.joinType === "application" ? "pending" : "member";
    setMemberStatus(prev => ({ ...prev, [joinTarget.id]: next }));
    setToast(next === "member" ? `Joined ${joinTarget.name}!` : "Application submitted.");
  }
  function handleLeave(id: string) {
    setMemberStatus(prev => ({ ...prev, [id]: "left" }));
    setToast("You've left the club.");
    setView("list");
  }

  if (view === "myclubs") return (
    <MyClubs memberStatus={memberStatus} onOpenClub={cl => { setSelected(cl); setView("detail"); }} onBrowse={() => setView("list")} />
  );
  if (view === "detail" && selected) return (
    <>
      <ClubDetail club={selected} status={memberStatus[selected.id] ?? "none"} saved={savedIds.has(selected.id)}
        onJoin={() => setJoinTarget(selected)} onLeave={() => handleLeave(selected.id)}
        onSave={() => toggleSave(selected.id)} onBack={() => setView("list")} />
      {joinTarget && <JoinModal club={joinTarget} onClose={() => setJoinTarget(null)} onDone={handleJoinDone} />}
      {toast && <Toast msg={toast} onDismiss={() => setToast(null)} />}
    </>
  );
  return (
    <>
      <ClubsList memberStatus={memberStatus} savedIds={savedIds} onJoin={openJoin} onToggleSave={toggleSave}
        onOpenClub={cl => { setSelected(cl); setView("detail"); }} onMyClubs={() => setView("myclubs")} />
      {joinTarget && <JoinModal club={joinTarget} onClose={() => setJoinTarget(null)} onDone={handleJoinDone} />}
      {toast && <Toast msg={toast} onDismiss={() => setToast(null)} />}
    </>
  );
}
